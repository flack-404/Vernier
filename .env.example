# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Pinata — app.pinata.cloud > API Keys > New Key.
# Copy the JWT, not the key/secret pair; the JWT is what the upload uses.
JWT=
API_Key=
API_Secret=

# The wallet that will own the on-chain registration.
# Use the same address you registered with at integrate.telegraphprotocol.com,
# so the entry is attributable to you when the submission is judged.
# Fund it with a little Base Sepolia ETH for gas; the bond itself is 0.
wallet_private_key=
